generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  xHandle       String?
  isCreator     Boolean   @default(false)
  isBanned      Boolean   @default(false)
  isPremium     Boolean   @default(false)
  premiumExpiry DateTime?
  stripeConnectAccountId  String?  // Stripe Connect アカウントID
  stripeConnectOnboarded  Boolean  @default(false) // オンボーディング完了
  stripeCustomerId        String?  // Stripe顧客ID（読者側の決済用）

  accounts     Account[]
  sessions     Session[]
  works        Work[]
  likes        Like[]
  comments     Comment[]
  followers    Follow[]  @relation("following")
  following    Follow[]  @relation("follower")
  tipsSent     Tip[]     @relation("tipsSent")
  tipsReceived Tip[]     @relation("tipsReceived")
  subscriptionPlans SubscriptionPlan[] @relation("creatorPlans")
  subscriptions     Subscription[]     @relation("subscriptions")
  subscribers       Subscription[]     @relation("subscribers")
  premiumSubscriptions PremiumSubscription[]
  pushSubscriptions    PushSubscription[]
  instagramAccount     InstagramAccount?
  notifications        Notification[]
  series               Series[]
  readHistory          ReadHistory[]
  reports              Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Instagram公式連携（Instagram API with Instagram Login）で取得した本人アカウントの接続情報
model InstagramAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId    String    // Instagram User ID
  username    String?
  accessToken String    @db.Text // 長期トークン（60日・期限前に更新）
  tokenExpiry DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Work {
  id          String   @id @default(cuid())
  title       String
  description String?
  panels      String[] // 1〜16枚の画像URL（順番通り）
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  tags        Tag[]
  likes       Like[]
  comments    Comment[]
  rankings    WeeklyRanking[]
  tips        Tip[]
  readHistory ReadHistory[]
  reports     Report[]

  seriesId    String?
  seriesOrder Int?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  viewCount   Int     @default(0)
  likeCount   Int     @default(0)
  tipTotal    Int     @default(0)
  isPublished Boolean @default(true)
  xPostUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([likeCount])
  @@index([seriesId, seriesOrder])
  // フィード（isPublished絞り込み + 並び替え）用の複合index
  @@index([isPublished, createdAt])
  @@index([isPublished, likeCount])
  @@index([authorId, createdAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  emoji String @default("")
  works Work[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  reaction  String   @default("like") // like, laugh, cry, empathy, amazing
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([workId])
  @@index([workId, reaction])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  workId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([workId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model WeeklyRanking {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  score     Int
  rank      Int
  weekStart DateTime

  createdAt DateTime @default(now())

  @@unique([workId, weekStart])
  @@index([weekStart, rank])
}

model Tip {
  id          String   @id @default(cuid())
  amount      Int      // 金額（円）
  platformFee Int      // プラットフォーム手数料（円）
  netAmount   Int      // クリエイター受取額（円）
  message     String?  // 応援メッセージ（任意）

  senderId    String
  receiverId  String
  workId      String
  // 財務レコードはユーザー/作品削除で消さない（会計・税務・係争対応のため保持）
  sender      User     @relation("tipsSent", fields: [senderId], references: [id], onDelete: Restrict)
  receiver    User     @relation("tipsReceived", fields: [receiverId], references: [id], onDelete: Restrict)
  work        Work     @relation(fields: [workId], references: [id], onDelete: Restrict)

  paymentStatus         String  @default("completed")
  stripePaymentIntentId String?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([workId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation("creatorPlans", fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  price       Int      // 月額（円）100〜10000
  description String?
  isActive    Boolean  @default(true)

  stripePriceId   String?  // Stripe Price ID
  stripeProductId String?  // Stripe Product ID

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

model Subscription {
  id               String   @id @default(cuid())
  subscriberId     String
  subscriber       User     @relation("subscriptions", fields: [subscriberId], references: [id], onDelete: Restrict)
  creatorId        String
  creator          User     @relation("subscribers", fields: [creatorId], references: [id], onDelete: Restrict)
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  status           String   @default("active") // active | cancelled | expired
  currentPeriodEnd DateTime

  amount           Int      // 課金額（円）
  platformFee      Int      // 手数料15%
  netAmount        Int      // クリエイター受取額
  paymentStatus    String   @default("completed")
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriberId, creatorId])
  @@index([creatorId])
  @@index([subscriberId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model PremiumSubscription {
  id               String   @id @default(cuid())
  userId           String
  // 財務レコードはユーザー削除で消さない（保持）
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  status           String   @default("active") // active | cancelled | expired
  amount           Int      @default(300)       // 300円/月
  currentPeriodEnd DateTime

  paymentStatus    String   @default("completed")
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Series {
  id          String  @id @default(cuid())
  title       String
  description String?
  coverImage  String? // シリーズ表紙（1話目の1コマ目をデフォルト使用）
  authorId    String
  author      User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  works       Work[]
  isCompleted Boolean @default(false) // 完結済みフラグ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model ReadHistory {
  id     String   @id @default(cuid())
  userId String
  workId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work   Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId, readAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Push Notification Models ───

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id       String  @id @default(cuid())
  userId   String
  type     String  // new_work, like, comment, follow, tip
  title    String
  body     String
  link     String?
  imageUrl String?
  isRead   Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(cuid())
  workId     String
  reporterId String
  reason     String   // spam | inappropriate | copyright | other
  detail     String?
  status     String   @default("pending") // pending | reviewed | dismissed
  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workId, reporterId])
  @@index([status])
}

model Advertisement {
  id          String    @id @default(cuid())
  title       String
  company     String
  imageUrl    String
  linkUrl     String
  description String?
  placement   String    @default("feed") // "feed" | "work" | "all"
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int       @default(0)
  impressions Int       @default(0)
  clicks      Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, placement])
}

model CreatorOutreach {
  id         String   @id @default(cuid())
  xHandle    String   @unique
  name       String
  genre      String   // 日常, 育児, 猫, ギャグ, エッセイ, その他
  followers  Int      @default(0)
  status     String   @default("候補") // 候補, いいね中, DM送信済, 返信あり, 登録済み, 見送り
  note       String?
  dmSentAt   DateTime?
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([genre])
}
