generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  xHandle       String?
  isCreator     Boolean   @default(false)
  isBanned      Boolean   @default(false)

  accounts     Account[]
  sessions     Session[]
  works        Work[]
  likes        Like[]
  comments     Comment[]
  followers    Follow[]  @relation("following")
  following    Follow[]  @relation("follower")
  tipsSent     Tip[]     @relation("tipsSent")
  tipsReceived Tip[]     @relation("tipsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          String   @id @default(cuid())
  title       String
  description String?
  panels      String[] // 4枚の画像URL（順番通り）
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  tags        Tag[]
  likes       Like[]
  comments    Comment[]
  rankings    WeeklyRanking[]
  tips        Tip[]

  viewCount   Int     @default(0)
  likeCount   Int     @default(0)
  tipTotal    Int     @default(0)
  isPublished Boolean @default(true)
  xPostUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([likeCount])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  emoji String @default("")
  works Work[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([workId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  workId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([workId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model WeeklyRanking {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  score     Int
  rank      Int
  weekStart DateTime

  createdAt DateTime @default(now())

  @@unique([workId, weekStart])
  @@index([weekStart, rank])
}

model Tip {
  id          String   @id @default(cuid())
  amount      Int      // 金額（円）
  platformFee Int      // プラットフォーム手数料（円）
  netAmount   Int      // クリエイター受取額（円）
  message     String?  // 応援メッセージ（任意）

  senderId    String
  receiverId  String
  workId      String
  sender      User     @relation("tipsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("tipsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  paymentStatus         String  @default("completed")
  stripePaymentIntentId String?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([workId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
